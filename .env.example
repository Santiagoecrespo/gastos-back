# Production database and JWT signing key
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
SECRET_KEY=replace-with-a-long-random-secret

# Transactional email (SMTP). Configure these in the backend host so codes are
# delivered automatically. Resend, Brevo, Mailgun and most custom domains offer
# SMTP credentials.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=your-smtp-username
SMTP_PASSWORD=your-smtp-password
SMTP_USE_TLS=true
SMTP_USE_SSL=false
EMAIL_FROM=SplitWise <hola@your-domain.com>

# Public address of the published frontend, used by the browser build.
# VITE_API_URL=https://your-backend.example.com
